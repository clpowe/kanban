{
  "name": "kanban",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun dev:client dev:css dev:server",
    "dev:client": "vp dev",
    "dev:css": "npx @tailwindcss/cli -i ./src/styles/app.css -o ./public/app.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/app.css -o ./public/app.css --minify",
    "build:client": "vp build",
    "dev:server": "wrangler dev",
    "deploy": "vp build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@tailwindcss/cli": "^4.2.2",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.2",
    "typed-htmx": "^0.3.1",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.74.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "better-auth": "^1.5.5",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "solid-js": "^1.9.13"
  },
  "packageManager": "bun@1.3.14"
}
