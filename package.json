{
  "name": "kanban",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun dev:client dev:css dev:server",
    "dev:client": "vp dev",
    "dev:css": "npx @tailwindcss/cli -i ./src/styles/app.css -o ./public/app.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/app.css -o ./public/app.css --minify",
    "build:client": "vp build",
    "dev:server": "wrangler dev",
    "deploy": "vp build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260607.1",
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "latest",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "daisyui": "^5.5.23",
    "tailwindcss": "^4.3.0",
    "typed-htmx": "^0.3.1",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.98.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@solidjs/router": "^0.16.1",
    "better-auth": "^1.6.14",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "kysely": "0.27.4",
    "posthog-node": "^5.36.17",
    "solid-js": "^1.9.13"
  },
  "packageManager": "bun@1.3.14"
}
